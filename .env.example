DATABASE_URL=postgresql://ia_rag_service@.../innovateaxis
# ^ the SERVICE role. Never the owner, never a superuser.

IA_RAG_VERIFICATION_DSN=
# ^ ONLY for `python -m src.db.offboard_cli`. A role that BYPASSES RLS, so a
#   post-offboarding count can see what the policy would hide; a count taken
#   over DATABASE_URL reads zero for every tenant whether or not the purge ran.
#   MUST NOT equal DATABASE_URL, and the CLI refuses if it does: the purge runs
#   on that pool and its deletes carry no tenant predicate, so on a bypassing
#   connection they would remove every tenant's rows. Unset everywhere except
#   the operator shell running an offboarding.

ANTHROPIC_API_KEY=
EMBED_MODEL=text-embedding-3-large
EMBED_DIM=1536
GENERATION_MODEL=claude-<pinned-version>
RERANK_MODEL=<pinned>
PROMPT_VERSION=v2

# Cost control
MONTHLY_USD_CAP=200
PER_QUERY_USD_CAP=0.05
PER_TENANT_DAILY_QUERY_CAP=500

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
CORE_API_JWKS_URL=https://api.innovateaxis.example/.well-known/jwks.json

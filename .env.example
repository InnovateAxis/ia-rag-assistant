DATABASE_URL=postgresql://ia_rag_service@.../innovateaxis
# ^ the SERVICE role. Never the owner, never a superuser.

ANTHROPIC_API_KEY=
EMBED_MODEL=text-embedding-3-large
EMBED_DIM=1536
GENERATION_MODEL=claude-<pinned-version>
RERANK_MODEL=<pinned>
PROMPT_VERSION=v2

# Cost control
MONTHLY_USD_CAP=200
PER_QUERY_USD_CAP=0.05
PER_TENANT_DAILY_QUERY_CAP=500

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
CORE_API_JWKS_URL=https://api.innovateaxis.example/.well-known/jwks.json
